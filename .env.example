# Copy to .env on the server. Never commit real values.
NEBIUS_API_KEY=
WARRANT_ADMIN_TOKEN=            # 32+ random characters; required for drafting, approving and running
WARRANT_DATA_DIR=data
WARRANT_PORTAL_URL=http://127.0.0.1:8201
WARRANT_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
WARRANT_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
WARRANT_ENFORCER=proxy          # "openshell" on the Linux host
WARRANT_RUN_MAX_MODEL_CALLS=40
WARRANT_GUEST_DAILY_USD_CAP=3.00
# USD per million tokens, only from the Token Factory price page: {"model-id": [input, output]}
WARRANT_PRICES_JSON={}
TAVILY_API_KEY=                 # optional
